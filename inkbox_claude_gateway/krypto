#!/usr/bin/env python3
"""Krypto-Trader add-on: status and control. Prints JSON.

  krypto status        value, profit/loss, comparison with just holding Bitcoin, holdings
  krypto verlauf [N]   the last N decisions of Claude with reasons (default 3)
  krypto stopp         pause trading (stop-losses keep protecting the coins)
  krypto notaus        pause trading AND sell everything
  krypto weiter        allow trading again
  krypto jetzt         let Claude decide right now instead of waiting for the daily time
"""

import json
import os
import sys
import urllib.error
import urllib.request

BASE = os.environ.get("KRYPTO_URL", "").rstrip("/")


def out(data) -> None:
    print(json.dumps(data, ensure_ascii=False, indent=1))


def call(method: str, path: str, body: dict | None = None, timeout: int = 60):
    if not BASE:
        out({"error": "Der Krypto-Trader ist nicht verbunden (Option krypto_url im Gateway)."})
        sys.exit(1)
    data = json.dumps(body or {}).encode() if method == "POST" else None
    req = urllib.request.Request(BASE + path, data=data, method=method, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read() or b"null")
    except urllib.error.HTTPError as err:
        try:
            return json.loads(err.read())
        except ValueError:
            out({"error": f"Fehler {err.code}"})
            sys.exit(1)
    except (urllib.error.URLError, OSError) as err:
        out({"error": f"Krypto-Trader nicht erreichbar ({BASE}): {getattr(err, 'reason', err)}"})
        sys.exit(1)


def main(argv: list[str]) -> None:
    cmd = argv[0].lower() if argv else "--help"
    if cmd in ("-h", "--help"):
        print(__doc__.strip())
    elif cmd == "status":
        s = call("GET", "/api/status")
        if not s.get("ready"):
            out(s)
            return
        out({k: s.get(k) for k in ("mode", "halted", "halt_reason", "value", "pnl_pct", "start_value", "cash",
                                    "btc_hold", "basket_hold", "holdings", "last_decision", "risk", "locked", "error")})
    elif cmd == "verlauf":
        n = int(argv[1]) if len(argv) > 1 and argv[1].isdigit() else 3
        s = call("GET", "/api/status")
        out([{k: d.get(k) for k in ("date", "summary", "fills", "notes")} for d in (s.get("decisions") or [])[:n]])
    elif cmd == "stopp":
        out(call("POST", "/api/halt", {"sell_all": False}))
    elif cmd == "notaus":
        out(call("POST", "/api/halt", {"sell_all": True}, timeout=180))
    elif cmd == "weiter":
        out(call("POST", "/api/resume"))
    elif cmd == "jetzt":
        out(call("POST", "/api/decide", timeout=1200))
    else:
        out({"error": "Unbekannter Aufruf. Siehe: krypto --help"})
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])
